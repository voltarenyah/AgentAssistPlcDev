                        },
                        {
                          "type": "text",
                          "id": "HMRXW",
                          "name": "Line",
                          "fill": "#6A9955",
                          "content": "// Static Variables",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "ibav1",
                          "name": "Line",
                          "fill": "#569CD6",
                          "content": "VAR",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "lj7Be",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "    speedRamp       : Real := 0.0;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "w0U08j",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "    timerStart      : TON_TIME;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "g6yl9g",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "    estopActive     : Bool := FALSE;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "v8UKL",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "    speedPID        : PID_Compact;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "qrHRX",
                          "name": "Line",
                          "fill": "#569CD6",
                          "content": "END_VAR",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "DMg8d",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": " ",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "bjwOP",
                          "name": "Line",
                          "fill": "#569CD6",
                          "content": "BEGIN",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "bxJOk",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": " ",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "YXxxe",
                          "name": "Line",
                          "fill": "#6A9955",
                          "content": "    // E-Stop monitoring with dual-channel",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "s0laqz",
                          "name": "Line",
                          "fill": "#C586C0",
                          "content": "    IF stopBtn THEN",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "M9zisU",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "        estopActive := TRUE;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Xlu65",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "        motorRun := FALSE;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "yVUoD",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "        motorSpeed := 0.0;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "HpH7F",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": "        faultCode := 16#E001;     // Emergency stop",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "B3PFo",
                          "name": "Line",
                          "fill": "#C586C0",
                          "content": "    END_IF;",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "mP6Gs",
                          "name": "Line",
                          "fill": "#CCCCCC",
                          "content": " ",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "tnKUZ",
                          "name": "Line",
                          "fill": "#6A9955",
                          "content": "    // Speed ramp with acceleration limit",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Err5D",
                          "name": "Line",
                          "fill": "#C586C0",
                          "content": "    IF startBtn AND NOT estopActive AND photoSensor THEN",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "QWYAI",
                          "name": "Line",
                          "fill": "#CE9178",
                          "content": "        speedRamp := MIN(speedRamp + 2.5, speedSetpoint);",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "oP24A",
                          "name": "Line",
                          "fill": "#C586C0",
                          "content": "    ELSE",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Um9Zs",
                          "name": "Line",
                          "fill": "#C586C0",
                          "content": "END_FUNCTION_BLOCK",
                          "lineHeight": 1.55,
                          "fontFamily": "$tia-font-code",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
